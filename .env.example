# ─────────────────────────────────────────────────────────────
# New Blossom Hotel & Spa — Environment Configuration
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── App ──
APP_ENV=development
APP_PORT=8080
APP_NAME=new-blossom-api

# ── PostgreSQL (host machine) ──
DB_HOST=host-gateway
DB_PORT=5432
DB_USER=nb_admin
DB_PASSWORD=nb_admin_2025
DB_NAME=new_blossom
DB_SSLMODE=disable
DB_MAX_CONNS=25

# ── JWT ──
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ── MinIO (Docker container) ──
MINIO_ROOT_USER=nb_minio_admin
MINIO_ROOT_PASSWORD=nb_minio_secret_2025
MINIO_ENDPOINT=nb-minio:9000
MINIO_ACCESS_KEY=nb_minio_admin
MINIO_SECRET_KEY=nb_minio_secret_2025
MINIO_BUCKET=new-blossom-images
MINIO_USE_SSL=false

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Logging ──
LOG_LEVEL=info
LOG_FORMAT=text
